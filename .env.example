# Ledgerly — example environment file.
#
# Copy to `.env` and fill in real values. Every variable here is documented
# in ARCHITECTURE.md §7.2 and validated at startup by packages/config/src/env.ts
# (D-14) — a missing or malformed value refuses to boot rather than failing
# later, mid-request.
#
# No real hostname, AUD tag, or key belongs in this file, ever (CLAUDE.md).

# --- Runtime -----------------------------------------------------------
NODE_ENV=development

# --- App -----------------------------------------------------------------
# Host bind and container port (D-16). Never hardcode this — docker-compose
# and the Dockerfile both read it from here.
APP_PORT=3000
# Public hostname, used for absolute URLs (D-16). Placeholder only — this is
# the IANA-reserved example domain, not a real one.
APP_HOSTNAME=receipts.example.com

# --- Postgres (used by docker-compose to build DATABASE_URL) -------------
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=ledgerly

# The application reads DATABASE_URL directly, not the POSTGRES_* pieces
# above. In docker-compose this is composed for you; set it explicitly for
# local (non-Docker) development.
DATABASE_URL=postgres://ledgerly:change-me-before-first-run@localhost:5432/ledgerly

# Tests never run against DATABASE_URL (D-18) -- they run against a separate
# database, inside a transaction that is rolled back after each test. CI sets
# this to its throwaway postgres:17 service; set it here for local runs.
# Create the database once with:
#   docker compose up -d db
#   docker compose exec db psql -U ledgerly -d ledgerly -c 'CREATE DATABASE ledgerly_test'
#   TEST_DATABASE_URL=... pnpm --filter @ledgerly/db db:migrate
TEST_DATABASE_URL=postgres://ledgerly:change-me-before-first-run@localhost:5432/ledgerly_test

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Secrets / crypto ------------------------------------------------------
# 32 bytes, base64-encoded. Encrypts the app_config table (backup.schedule_cron,
# ai.escalate_below, ...). Generate with:
#   openssl rand -base64 32
# BACK THIS UP OUT-OF-BAND. It is never included in a backup archive, and a
# backup cannot be decrypted without it (docs/SCHEMA.md §app_config).
MASTER_KEY=

# --- Filesystem (named volumes in docker-compose) ---------------------------
UPLOADS_DIR=/app/uploads
BACKUPS_DIR=/app/backups

# --- Cloudflare Access -------------------------------------------------------
# Set to true only once Access is actually fronting the app. Required
# (along with CF_ACCESS_AUD and CF_ACCESS_TEAM_DOMAIN) when NODE_ENV=production
# — packages/config refuses to boot otherwise (D-14).
CF_ACCESS_ENABLED=false
# Application Audience tag from the Cloudflare Access dashboard. Must be
# exactly 64 lowercase hex characters — an empty or placeholder value fails
# at startup, never at verification time (D-25). Never commit a real one.
CF_ACCESS_AUD=
# Your Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com.
# Never commit a real one.
CF_ACCESS_TEAM_DOMAIN=
# JWKS cache TTL in milliseconds (D-29). 1 hour by default; lower it only if
# you need faster key-rotation pickup.
CF_ACCESS_JWKS_TTL_MS=3600000

# --- Dev / recovery flags ----------------------------------------------------
# Injects a fixed development identity and skips JWT verification.
# Defaults to false, including here: this file is meant to be copied to
# .env, and docker-compose reads .env via env_file, so a `true` default
# ships the unsafe combination to anyone who follows the setup steps.
# Flip it to true only for local `pnpm dev`, never for a container.
# packages/config REFUSES TO BOOT if this is true while NODE_ENV=production
# (D-05) — enforced in BOTH the Node process (at startup, via
# instrumentation) and independently inside the Edge runtime (edge.ts), and
# it cannot be disabled by any other setting.
DEV_AUTH_BYPASS=false
# Off except during a deliberate identity-provider migration (D-27). When
# true, a new Cloudflare Access `sub` whose email matches exactly one
# existing user is reassigned onto that user's row instead of provisioning a
# new account — the recovery path for "you changed your IdP and everyone,
# including the owner, is now locked out." Every reassignment is audited.
# packages/config WARNs at every boot while this is true, specifically so it
# is never left on by accident after the migration is done. Turn it back off
# immediately afterward. See SETUP.md for the full procedure.
ACCESS_ALLOW_SUB_RELINK=false

# --- AI extraction (server-side only — never in a client bundle, CLAUDE.md) -
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
AI_MODEL_PASS1=claude-haiku-4-5
AI_MODEL_PASS2=claude-sonnet-5
AI_ESCALATE_BELOW=0.6
AI_CONCURRENCY=3

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
# ~10x storage if true (D-09). Off by default.
RETAIN_ORIGINALS=false

# --- Misc --------------------------------------------------------------------
DEFAULT_CURRENCY=USD
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_IMAGES=false
