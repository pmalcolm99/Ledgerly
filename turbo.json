{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  // Turbo 2's default "strict" env mode silently drops any env var not
  // explicitly allowlisted, which broke both `next build` (packages/config's
  // startup parse — D-14) and TEST_DATABASE_URL reaching packages/db's test
  // harness (D-18). "loose" passes the invoking shell's environment through
  // unfiltered, same as running each task directly — appropriate here since
  // every var is Zod-validated at the point of use regardless of how it
  // arrived, and an allowlist would just be ARCHITECTURE.md §7.2's table
  // duplicated somewhere it can silently drift out of sync.
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NODE_ENV in the task hash, deliberately.
      //
      // "loose" above passes the shell's environment through, but it does
      // NOT put it in the cache key — so a build produced under one NODE_ENV
      // could be replayed under another. Verified: `NODE_ENV=production` and
      // NODE_ENV unset both hashed to 2c6b4b8a363bb1e4, and the second run
      // was a cache hit.
      //
      // That is benign today only because `next build` under
      // NODE_ENV=development FAILS outright (it tries to prerender /404 and
      // /500 from the pages-router error component and dies on
      // `<Html> should not be imported outside of pages/_document`) rather
      // than producing a different-but-valid artifact. Relying on a
      // coincidence like that is not a cache-correctness argument, so the
      // var goes in the key.
      "env": ["NODE_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    // Run serially via the root script's --concurrency=1. Every
    // database-touching suite shares one TEST_DATABASE_URL, and
    // withCleanDatabase() TRUNCATEs it, which needs ACCESS EXCLUSIVE —
    // concurrent packages clobber each other's fixtures. Raised as M-6 in
    // the task 3.12 review. The durable fix is a database per package;
    // until then this is what makes `pnpm test` deterministic.
    "test": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
